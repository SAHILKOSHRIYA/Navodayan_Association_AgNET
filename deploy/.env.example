# NAU platform — environment variables (copy to .env and fill in; never commit real values).
# Config keys use the ASP.NET Core "__" convention (Section__Key).

# ── Database ───────────────────────────────────────────────────────────────
# Native Npgsql string OR a postgres:// URL (Render/Heroku style) — both are accepted.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=nau;Username=nau;Password=change_me
Database__MigrateOnStartup=true

# ── Auth ───────────────────────────────────────────────────────────────────
Jwt__Secret=change_me_to_a_long_random_at_least_32_byte_secret
Jwt__Issuer=nau-api
Jwt__Audience=nau-clients

# Public base URL of the app — used in verification / password-reset email links.
Client__BaseUrl=http://localhost:5080

# ── First super-admin (seeded on first boot; change the password afterwards) ─
Seed__SuperAdmin__Email=admin@example.com
Seed__SuperAdmin__Password=change_me_Str0ng!
Seed__SuperAdmin__FullName=NAU Administrator

# ── Payments (Razorpay) ────────────────────────────────────────────────────
# "test" uses the built-in deterministic gateway; "razorpay" calls the live API.
Payments__Provider=test
Payments__KeyId=
Payments__KeySecret=
Payments__WebhookSecret=

# ── CORS (only needed if the client is hosted on a DIFFERENT origin than the API) ─
# Cors__AllowedOrigins__0=https://your-frontend.example.com
